# Shell/SLURM scripts must keep LF line endings regardless of the
# committing machine's git config (autocrlf) - a CRLF shebang line breaks
# with "bad interpreter" on Fox (Linux).
*.sh text eol=lf
*.sbatch text eol=lf
*.env text eol=lf

# Local agent instructions are not part of a public source archive.
CLAUDE.md export-ignore
