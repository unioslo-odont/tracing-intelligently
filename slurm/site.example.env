# ==============================================================================
# SITE SETTINGS TEMPLATE - copy to local/site.env (git-ignored) and edit:
#     mkdir -p local && cp slurm/site.example.env local/site.env
# slurm/env.sh sources local/site.env before anything else, so source env.sh
# in the shell you submit jobs from: sbatch inherits these exports.
# All values below are placeholders.
# ==============================================================================

# Python environment and caches (required)
export OPENCEPH_VENV=/path/to/project/python_envs/openceph_env
export OPENCEPH_CACHE_ROOT=/path/to/project/cache
# Reuse an existing pretrained-weight cache instead of $OPENCEPH_CACHE_ROOT/huggingface:
# export HF_HOME=/path/to/project/hf_cache

# Modules the venv was built against (defaults in slurm/env.sh)
# export OPENCEPH_PYTHON_MODULE=Python/3.11.5-GCCcore-13.2.0
# export OPENCEPH_CUDA_MODULE=CUDA/12.6.0

# SLURM account: overrides the scripts' "#SBATCH --account=YOUR_ACCOUNT"
export SBATCH_ACCOUNT=YOUR_ACCOUNT
export SALLOC_ACCOUNT=YOUR_ACCOUNT

# External test set root (slurm/evaluate_aariz.sbatch, chin_eyeball_overlay.py)
export AARIZ_ROOT=/path/to/project/data/Aariz
